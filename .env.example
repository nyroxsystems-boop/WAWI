INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_USER=inventree
INVENTREE_DB_PASSWORD=inventree
INVENTREE_DB_HOST=localhost
INVENTREE_DB_PORT=5432

# JWT / auth
SECRET_KEY=dev-secret-key

# File storage (optional override)
MEDIA_ROOT=./data/media

# CORS / Hosts
INVENTREE_CORS_ORIGIN_WHITELIST=http://localhost:5173,http://127.0.0.1:5173
INVENTREE_ALLOWED_HOSTS=localhost,127.0.0.1
