{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderOffersShopView",
  "type": ["array", "object"],
  "anyOf": [
    { "type": "array", "items": { "$ref": "#/definitions/Offer" } },
    {
      "type": "object",
      "required": ["offers"],
      "properties": {
        "order_id": { "type": ["string", "integer", "null"] },
        "offers": { "type": "array", "items": { "$ref": "#/definitions/Offer" } }
      }
    }
  ],
  "definitions": {
    "Offer": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "supplier_id": { "type": ["string", "integer", "null"] },
        "supplier_name": { "type": ["string", "null"] },
        "product_name": { "type": ["string", "null"] },
        "brand": { "type": ["string", "null"] },
        "base_price": { "type": ["number", "string", "null"] },
        "price": { "type": ["number", "string", "null"] },
        "tier": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "status": { "type": "string" }
      }
    }
  }
}
