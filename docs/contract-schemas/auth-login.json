{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthLoginResponse",
  "type": "object",
  "required": ["access", "refresh", "user", "tenant"],
  "properties": {
    "access": { "type": "string" },
    "refresh": { "type": "string" },
    "user": {
      "type": "object",
      "required": ["id", "username", "email"],
      "properties": {
        "id": { "type": ["integer", "string"] },
        "username": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "tenant": {
      "type": "object",
      "required": ["id", "name", "role"],
      "properties": {
        "id": { "type": ["integer", "string"] },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    }
  }
}
